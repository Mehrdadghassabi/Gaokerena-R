\@writefile{lot}{\contentsline {table}{\numberline {17}{\ignorespaces Pooled accuracy (\%) on the six medical MMLU subjects (1,089 questions) in English and Persian, single runs. For each Persian system, $\Delta $ is English Aya-Expanse-8B minus that system (percentage points) and $p$ is from an unpaired two-proportion $z$-test (uncorrected); the English row has no counterpart and is left blank. The verifier configuration has no English counterpart, so its two $\Delta $/$p$ entries compare it against English straight prompting and English CoT-SC, respectively. Persian counts are recovered from the percentages of Tables\nonbreakingspace \ref {tab:model_results_vs_general_purpose_languages} and\nonbreakingspace \ref {tab:cotsc}.}}{26}{table.caption.36}\protected@file@percent }
\newlabel{tab:en_fa}{{17}{26}{Pooled accuracy (\%) on the six medical MMLU subjects (1,089 questions) in English and Persian, single runs. For each Persian system, $\Delta $ is English Aya-Expanse-8B minus that system (percentage points) and $p$ is from an unpaired two-proportion $z$-test (uncorrected); the English row has no counterpart and is left blank. The verifier configuration has no English counterpart, so its two $\Delta $/$p$ entries compare it against English straight prompting and English CoT-SC, respectively. Persian counts are recovered from the percentages of Tables~\ref {tab:model_results_vs_general_purpose_languages} and~\ref {tab:cotsc}}{table.caption.36}{}}
